# Copy to .env. Never commit .env. Generate unique values before first startup.
# A hex password avoids percent-encoding inside the Compose DATABASE_URL.
# Example generation: openssl rand -hex 32
POSTGRES_DB=secondbrain
POSTGRES_USER=secondbrain
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Used by local Prisma/Next.js. Substitute the same password as above.
# Compose builds its own URL using the internal service DNS name.
DATABASE_URL=postgresql://secondbrain:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/secondbrain?schema=public

# Generate a DIFFERENT random value: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Exact browser origin. Use https://your-pi.your-tailnet.ts.net in production.
BETTER_AUTH_URL=http://localhost:3000

# Set for initial bootstrap; signup is otherwise closed.
# Existing accounts are never reset by startup. Remove the password after setup.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Synapse

# Default is host-only, ideal for Tailscale Serve or a local TLS reverse proxy.
# For LAN TLS proxying, set a specific LAN IP and configure that proxy securely.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
# Private attachment storage (local development); Docker mounts its own named volume.
ATTACHMENT_STORAGE_PATH=./data/attachments
MAX_ATTACHMENT_SIZE_MB=25
